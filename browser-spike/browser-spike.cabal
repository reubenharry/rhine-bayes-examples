cabal-version:      3.0
name:               browser-spike
version:            0.1.0.0
synopsis:           WASM + canvas runner for Rhine-style demos
license:            BSD-3-Clause
build-type:         Simple

executable browser-spike
  main-is:          Main.hs
  other-modules:
      Picture
      UserInput
      Demo
      Canvas
      RhineCompat
      BayesLite
      Util
      Inference
      Tracker
  hs-source-dirs:   app, src
  default-language: GHC2021
  default-extensions:
      Arrows
      BlockArguments
      FlexibleContexts
      FlexibleInstances
      MultiParamTypeClasses
      NamedFieldPuns
      RankNTypes
      TypeFamilies
      TypeOperators
  ghc-options:
      -Wall
      -no-hs-main
      -optl-mexec-model=reactor
      "-optl-Wl,--export=hs_startDemo"
  build-depends:
      base >= 4.16 && < 5
    , ghc-experimental
    , dunai
    , containers
    , transformers
    , mtl
    , simple-affine-space
    , random
